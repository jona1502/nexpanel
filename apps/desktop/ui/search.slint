// NexSearch window. Design tokens as in main.slint: bg #181a20, surface #252832,
// border #343640, text #f3f4f8, muted #979eaf. Heights/width mirror `search_window.rs`.
export struct SearchItem { title:string, subtitle:string, glyph:string, hint:string }

component ResultRow inherits Rectangle {
 in property<SearchItem> item; in property<bool> selected; in property<color> accent; in property<bool> animations:true;
 callback clicked(); callback moved();
 height:48px; border-radius:8px;
 background:root.selected?#252832:transparent;
 animate background {duration:root.animations?120ms:0ms;}
 Rectangle {x:0px;y:(parent.height - 20px)/2;width:3px;height:20px;border-radius:1.5px;background:root.accent;opacity:root.selected?1:0;
  animate opacity {duration:root.animations?120ms:0ms;}}
 HorizontalLayout {padding-left:14px;padding-right:14px;spacing:12px;
  Rectangle {width:32px;
   Rectangle {width:32px;height:32px;border-radius:8px;background:root.selected?#343640:#2b2e39;
    Text {text:root.item.glyph;color:root.selected?root.accent:#b6bdcc;font-size:16px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}}}
  VerticalLayout {horizontal-stretch:1;alignment:center;spacing:1px;
   Text {text:root.item.title;color:#f3f4f8;font-size:15px;overflow:elide;}
   if root.item.subtitle!="": Text {text:root.item.subtitle;color:#979eaf;font-size:12px;overflow:elide;}}
  Text {text:"↵  " + root.item.hint;color:#979eaf;font-size:12px;vertical-alignment:center;opacity:root.selected?1:0;
   animate opacity {duration:root.animations?120ms:0ms;}}
 }
 ta := TouchArea {clicked=>{root.clicked();} moved=>{root.moved();}}
}

export component SearchWindow inherits Window {
 title:"NexSearch"; no-frame:true; always-on-top:true; background:#181a20;
 default-font-family:"Segoe UI"; default-font-size:14px;
 preferred-width:640px; min-width:640px; max-width:640px;
 preferred-height:root.win-height; min-height:root.win-height; max-height:root.win-height;
 // Logical height; Rust computes it from the row count (`search_window::window_height`).
 in property<length> win-height:56px;
 in property<[SearchItem]> results;
 in property<int> selected:0;
 // Text of the empty-result row; empty hides it.
 in property<string> status;
 in property<color> accent:#809cff;
 in property<bool> animations:true;
 in-out property<string> query;
 // False before the show, then true: the content fades in.
 in-out property<bool> open:false;
 callback edited(string); callback activate(int); callback hover-row(int); callback results-ready();
 public function focus-input() { input.focus(); }
 Rectangle {
  opacity:root.open?1:0;
  animate opacity {duration:root.animations?140ms:0ms; easing:ease-out;}
  VerticalLayout {
   spacing:0px;
   Rectangle {height:56px;
    HorizontalLayout {padding-left:18px;padding-right:18px;spacing:12px;
     Rectangle {width:20px;
      Path {width:18px;height:18px;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:root.accent;stroke-width:1.5px;commands:"M7 2.5 A4.5 4.5 0 1 1 6.99 2.5 Z M10.4 10.4 L14 14";}}
     Rectangle {horizontal-stretch:1;
      if root.query=="": Text {text:@tr("NexSearch – suchen, rechnen, Befehle …");color:#979eaf;font-size:18px;vertical-alignment:center;overflow:elide;}
      input := TextInput {text<=>root.query;color:#f3f4f8;font-size:18px;single-line:true;vertical-alignment:center;selection-background-color:root.accent;selection-foreground-color:#14161c;
       edited=>{root.edited(self.text);}}}
    }}
   if root.results.length>0||root.status!="": Rectangle {height:1px;background:#343640;}
   if root.results.length>0: VerticalLayout {padding:6px;spacing:0px;
    for item[i] in root.results: ResultRow {item:item;selected:root.selected==i;accent:root.accent;animations:root.animations;
     clicked=>{root.activate(i);} moved=>{root.hover-row(i);}}}
   if root.results.length==0&&root.status!="": Rectangle {height:44px;
    Text {text:root.status;color:#979eaf;font-size:13px;horizontal-alignment:center;vertical-alignment:center;}}
  }
 }
 // Frame drawn last so content never covers it.
 Rectangle {border-width:1px;border-color:#343640;background:transparent;}
}
