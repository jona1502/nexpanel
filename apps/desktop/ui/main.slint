export { SearchWindow, SearchItem } from "search.slint";
import { AboutCard } from "about.slint";
import { ThinSlider } from "thin_slider.slint";
import { Dropdown, DropdownList } from "dropdown.slint";
import { TipRow, HoverTip } from "tooltip.slint";
import { Button, ScrollView, CheckBox, SpinBox, Palette } from "std-widgets.slint";
export struct DisplayRow { id:string, name:string, value:int, supported:bool, status:string }
export struct AudioItem { id:string, name:string, value:int, muted:bool, master:bool, initial:string, icon:image, has-icon:bool, peak:int, peak-color:color }
component Heading inherits Text { color:#f3f4f8; font-size:15px; font-weight:600; }
component Hint inherits Text { color:#979eaf; font-size:12px; wrap:word-wrap; height:self.preferred-height; }
component Card inherits Rectangle { background:#252832; border-radius:8px; }
// Label | 3px bar | value. level: 0 accent, 1 amber (>=80 %), 2 red (>=95 %).
component StatRow inherits Rectangle {
 in property<string> label; in property<string> text; in property<int> pct; in property<int> level; in property<color> accent;
 in property<bool> dimmed:false;
 height:28px; opacity:root.dimmed?0.45:1;
 HorizontalLayout {padding-left:4px;padding-right:4px;spacing:10px;
  Text{width:40px;text:root.label;color:#b6bdcc;font-size:13px;vertical-alignment:center;}
  Rectangle{horizontal-stretch:1;
   Rectangle{y:(parent.height - 3px)/2;width:parent.width;height:3px;border-radius:1.5px;background:#343640;
    Rectangle{x:0px;width:parent.width*max(0,min(100,root.pct))/100;height:3px;border-radius:1.5px;
     background:root.level==2?#ff6b6b:root.level==1?#ffb56b:root.accent;}}}
  Text{width:124px;text:root.text;color:#f3f4f8;font-size:13px;horizontal-alignment:right;vertical-alignment:center;overflow:elide;}
 }
}
component TabButton inherits Rectangle {
 in property<string> text; in property<bool> active; in property<color> accent;
 callback clicked();
 height:28px; border-radius:6px; background:root.active?#252832:ta.has-hover?#1f222b:transparent;
 Text{text:root.text;color:root.active?root.accent:#b6bdcc;font-size:13px;font-weight:root.active?600:400;horizontal-alignment:center;vertical-alignment:center;}
 ta := TouchArea{clicked=>{root.clicked();}}
}
component TimeSeg inherits Rectangle {
 in property<string> text; in property<bool> active; in property<color> accent;
 callback clicked(); callback scrolled(int);
 width:56px; border-radius:6px; background:root.active?#343640:ta.has-hover?#2a2d38:transparent;
 Text{text:root.text;color:root.active?root.accent:#f3f4f8;font-size:36px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
 ta := TouchArea{clicked=>{root.clicked();}
  scroll-event(e) => { if e.delta-y > 0 { root.scrolled(1); } else if e.delta-y < 0 { root.scrolled(-1); } return accept; }}
}
component ActionButton inherits Rectangle {
 in property<string> text; in property<bool> primary:false; in property<bool> enabled:true;
 callback clicked();
 height:30px; horizontal-stretch:1; border-radius:6px; opacity:root.enabled?1:0.45;
 background:root.primary?(ta.has-hover?#9bb2ff:#809cff):(ta.has-hover?#343640:#2b2e39);
 Text{text:root.text;color:root.primary?#14161c:#f3f4f8;font-size:13px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
 ta := TouchArea{enabled:root.enabled;mouse-cursor:pointer;clicked=>{root.clicked();}}
}
// Speaker glyph; `muted` swaps the sound waves for a cross. 16x16 viewbox, crisp at any scale.
component SpeakerIcon inherits Rectangle {
 in property<bool> muted; in property<color> tint:#e6e7ee;
 Path{width:100%;height:100%;viewbox-width:16;viewbox-height:16;fill:root.tint;commands:"M1.5 6 H4.5 L8.5 2.5 V13.5 L4.5 10 H1.5 Z";}
 if !root.muted: Path{width:100%;height:100%;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:root.tint;stroke-width:1.3px;commands:"M10.8 5.4 Q12.6 8 10.8 10.6 M12.6 3.6 Q16 8 12.6 12.4";}
 if root.muted: Path{width:100%;height:100%;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:root.tint;stroke-width:1.3px;commands:"M11 5.5 L15 10.5 M15 5.5 L11 10.5";}
}
component MonitorIcon inherits Rectangle {
 in property<color> tint:#e6e7ee;
 Path{width:100%;height:100%;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:root.tint;stroke-width:1.3px;commands:"M2 3.5 H14 V11 H2 Z M5.5 13.5 H10.5 M8 11 V13.5";}
}
// App icon (real icon when available), otherwise a rounded square with the first letter.
component AppIcon inherits Rectangle {
 in property<string> letter; in property<bool> muted; in property<image> icon; in property<bool> has-icon;
 callback clicked();
 out property<bool> hovered:ta.has-hover; out property<bool> pressed:ta.pressed;
 width:28px; height:28px; border-radius:6px; background:ta.has-hover?#2a2d38:transparent;
 if root.has-icon: Image{source:root.icon;width:24px;height:24px;opacity:root.muted?0.4:1;}
 if !root.has-icon: Rectangle{width:24px;height:24px;border-radius:5px;background:#343640;opacity:root.muted?0.4:1;
  Text{text:root.letter;color:#e6e7ee;font-size:13px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}}
 if root.muted: Path{x:root.width - 13px;y:root.height - 13px;width:10px;height:10px;viewbox-width:10;viewbox-height:10;fill:transparent;stroke:#ff8f8f;stroke-width:1.6px;commands:"M1 1 L9 9 M9 1 L1 9";}
 ta := TouchArea{mouse-cursor:pointer;clicked=>{root.clicked();}}
}
export component MainWindow inherits Window {
 init => { Palette.color-scheme = ColorScheme.dark; }
 title:"NexPanel"; preferred-width:392px; preferred-height:440px; min-width:392px; min-height:440px; max-width:392px; max-height:440px; no-frame:true; always-on-top:true;
 background:#181a20; default-font-family:"Segoe UI"; default-font-size:13px;
 in-out property<int> tab:0;
 in property<string> app-version;
 in-out property<bool> show-about:false;
 in property<[DisplayRow]> displays;
 in property<[AudioItem]> audio;
 in property<string> audio-device:"Lautstärke";
 in property<string> display-status:"Monitore werden erkannt …";
 in property<string> audio-status:"Audio wird erkannt …";
 in property<string> system-status:"Messung startet …";
 in property<string> cpu-text:"—"; in property<int> cpu-pct; in property<int> cpu-level;
 in property<string> ram-text:"—"; in property<int> ram-pct; in property<int> ram-level;
 in property<string> gpu-text:"—"; in property<int> gpu-pct; in property<int> gpu-level; in property<bool> gpu-available:true;
 in property<string> vram-text:"—"; in property<int> vram-pct; in property<int> vram-level;
 in property<string> gpu-name;
 in property<string> settings-error;
 in property<string> hotkey-status; in property<bool> hotkey-warning:false;
 in property<bool> settings-ready:false;
 in property<bool> settings-blocked:false;
 in-out property<int> accent-index:0;
 in-out property<bool> animations:true;
 in-out property<bool> focus-close:true;
 in-out property<bool> linked:false;
 in-out property<bool> autostart:false;
 in-out property<bool> auto-update-check:true;
 // Update state, see `update::machine::State::code` and `ErrorKind::code`.
 in property<int> update-state:0;
 in property<string> update-version;
 in property<int> update-progress:-1;
 in property<int> update-error-kind:0;
 in property<string> update-error-detail;
 in property<bool> update-managed:true;
 in property<bool> update-busy:false;
 in property<bool> update-can-install:false;
 // True while a dropdown list is open; Rust sets it to false to close it (Esc, panel hide).
 in-out property<bool> dropdown-open:false;
 // Tooltip state; `HoverTip` at the end of the window draws it.
 property<string> tip-text; property<length> tip-x; property<length> tip-y; property<length> tip-h; in-out property<bool> tip-visible:false;
 property<[string]> accent-names:["Blau","Violett","Grün","Orange"];
 property<[string]> hotkey-names:["Alt+Leertaste","Strg+Alt+Leertaste","Win+Alt+Leertaste"];
 property<[string]> position-names:["Mitte","Oben"];
 property<string> update-error-text:
  root.update-error-kind==1?@tr("Keine Verbindung zu GitHub."):
  root.update-error-kind==2?@tr("Verbindung abgelehnt: unerlaubte Adresse."):
  root.update-error-kind==3?@tr("Der Download ist größer als erlaubt."):
  root.update-error-kind==4?@tr("Prüfsumme stimmt nicht überein, das Update wurde verworfen."):
  root.update-error-kind==5?@tr("Das Paket ist ungültig, das Update wurde verworfen."):
  root.update-error-kind==6?@tr("Die Version im Paket passt nicht zum Release, das Update wurde verworfen."):
  root.update-error-kind==7?@tr("Diese Installation kann nicht automatisch aktualisiert werden (nicht mit install.ps1 installiert)."):
  root.update-error-kind==8?@tr("Keine Schreibrechte im Installationsordner."):
  root.update-error-kind==9?@tr("Die Installation ist fehlgeschlagen, die bisherige Version bleibt erhalten."):
  root.update-error-kind==10?@tr("Update installiert, aber NexPanel konnte nicht neu gestartet werden. Bitte manuell starten."):
  @tr("Das Update ist fehlgeschlagen.");
 property<string> update-status-text:
  root.update-state==1?@tr("Suche nach Updates …"):
  root.update-state==2?@tr("NexPanel ist aktuell."):
  root.update-state==3?@tr("Version {} ist verfügbar.", root.update-version):
  root.update-state==4?@tr("Lade Version {} herunter …", root.update-version):
  root.update-state==5?@tr("Prüfe Download …"):
  root.update-state==6||root.update-state==7?@tr("Installiere Version {} …", root.update-version):
  root.update-state==8?root.update-error-text:
  @tr("Noch nicht geprüft.");
 in-out property<int> hotkey-index:0; in-out property<int> position-index:0;
 in-out property<int> dropdown-kind:0;
 property<length> dd-x; property<length> dd-y; property<length> dd-w;
 // Scroll offset of the settings ScrollView (shared via two-way binding) and its value when the list was opened.
 property<length> scroll-y; property<length> dd-scroll0;
 // List anchor (field bottom + 4px) following the scrolled field; list closes once the field leaves the scroll area.
 property<length> dd-live-y: root.dd-y + root.scroll-y - root.dd-scroll0;
 property<bool> dd-in-view: !root.dropdown-open || (root.dd-live-y - 40px >= tab-sep.absolute-position.y + 1px && root.dd-live-y - 4px <= root.height - 10px);
 changed dd-in-view => { if !root.dd-in-view { root.dropdown-open=false; } }
 in property<string> countdown-text:"00:05:00";
 in property<string> stopwatch-text:"00:00:00";
 in property<bool> countdown-running:false;
 in property<bool> stopwatch-running:false;
 in property<bool> expired:false;
 in property<bool> countdown-active:false;
 in-out property<int> time-seg:2;
 in property<string> input-h:"00"; in property<string> input-m:"05"; in property<string> input-s:"00";
 out property<color> accent:accent-index==1?#b098ff:accent-index==2?#64d6a4:accent-index==3?#ffb56b:#809cff;
 function show-tip(t:string,x:length,y:length,h:length,s:bool){root.tip-text=t;root.tip-x=x;root.tip-y=y;root.tip-h=h;root.tip-visible=s;}
 changed tab => { root.tip-visible=false; root.scroll-y=0px; }
 callback hide-panel(); callback refresh-display(); callback refresh-audio();
 callback brightness(string,int); callback volume(string,int); callback mute(string,bool);
 callback time-digit(int); callback time-backspace(bool); callback time-step(int,int);
 callback check-updates(); callback install-update();
 callback save-settings(); callback reset-settings(); callback countdown-action(int); callback stopwatch-action(int);
 VerticalLayout {
 padding:10px; spacing:8px;
 HorizontalLayout { spacing:8px; height:24px;
 Text {text:"NexPanel";color:root.accent;font-size:16px;font-weight:700;vertical-alignment:center; animate color {duration:root.animations?160ms:0ms;}}
 Rectangle {horizontal-stretch:1;background:transparent;}
 Rectangle {width:24px;height:24px;border-radius:6px;background:close.has-hover?#343640:transparent;
  Text{text:"×";color:#b6bdcc;font-size:16px;horizontal-alignment:center;vertical-alignment:center;}
  close := TouchArea{clicked=>{root.hide-panel();}}}
 }
 HorizontalLayout {spacing:4px;
 for label[i] in ["Audio","Displays","System","Zeit","Einstellungen"]: TabButton {text:label; active:root.tab==i; accent:root.accent; clicked=>{root.tab=i;}}
 }
 tab-sep := Rectangle {height:1px;background:#343640;}
 if root.tab==0: VerticalLayout {vertical-stretch:1;spacing:6px;
 HorizontalLayout {height:26px;padding-left:4px;padding-right:4px;
 Text{text:root.audio-device;color:#f3f4f8;font-size:13px;horizontal-stretch:1;overflow:elide;vertical-alignment:center;}
 }
 if root.audio-status!="": Hint{text:root.audio-status;}
 if root.audio.length==0: Hint{text:"Kein Audiogerät verfügbar";horizontal-alignment:center;}
 VerticalLayout {spacing:0px;
 for row in root.audio: TipRow {height:row.master?48px:0px;visible:row.master;text:root.audio-device;inner-hover:mt.has-hover||msl.hovered;inner-pressed:mt.pressed||msl.pressed;tip(t,x,y,h,s)=>{root.show-tip(t,x,y,h,s);}
 HorizontalLayout {padding-left:4px;padding-right:4px;spacing:10px;
 Rectangle {width:32px;
  Rectangle{width:32px;height:32px;border-radius:6px;background:mt.has-hover?#2a2d38:transparent;}
  SpeakerIcon{width:20px;height:20px;muted:row.muted;tint:row.muted?#8a8d99:#e6e7ee;}
  mt := TouchArea{mouse-cursor:pointer;clicked=>{root.mute(row.id,!row.muted);}}}
 msl := ThinSlider{horizontal-stretch:1;value:row.value;dimmed:row.muted;changed(value)=>{root.volume(row.id,round(value));}}
 Text{width:44px;text:row.value;color:row.muted?#8a8d99:#f3f4f8;font-size:22px;horizontal-alignment:right;vertical-alignment:center;}
 }}
 }
 Rectangle {vertical-stretch:1;background:#13151a;border-radius:8px;
 ScrollView {
 VerticalLayout {alignment:start;padding-top:4px;padding-bottom:4px;
 for row in root.audio: TipRow {height:row.master?0px:36px;visible:!row.master;text:row.name;inner-hover:aic.hovered||asl.hovered;inner-pressed:aic.pressed||asl.pressed;tip(t,x,y,h,s)=>{root.show-tip(t,x,y,h,s);}
 HorizontalLayout {padding-left:8px;padding-right:8px;spacing:10px;
 Rectangle{width:28px;aic := AppIcon{letter:row.initial;icon:row.icon;has-icon:row.has-icon;muted:row.muted;clicked=>{root.mute(row.id,!row.muted);}}}
 asl := ThinSlider{horizontal-stretch:1;value:row.value;dimmed:row.muted;level:row.peak;level-color:row.peak-color;changed(value)=>{root.volume(row.id,round(value));}}
 Text{width:36px;text:row.value;color:row.muted?#8a8d99:#e6e7ee;font-size:15px;horizontal-alignment:right;vertical-alignment:center;}
 }}
 }
 }
 }
 }
 if root.tab!=0: ScrollView {vertical-stretch:1;content-y<=>root.scroll-y;
 VerticalLayout {spacing:8px;alignment:start; padding-right:6px; padding-bottom:12px;
 if root.tab==1: VerticalLayout {spacing:6px;alignment:start;
 HorizontalLayout {height:26px;padding-left:4px;spacing:6px;
 Text{text:"Helligkeit";color:#f3f4f8;font-size:13px;horizontal-stretch:1;vertical-alignment:center;}
 Rectangle {width:64px;border-radius:6px;background:root.linked?#252832:link.has-hover?#1f222b:transparent;opacity:root.settings-ready?1:0.5;
  Text{text:"Koppeln";color:root.linked?root.accent:#b6bdcc;font-size:12px;horizontal-alignment:center;vertical-alignment:center;}
  link := TouchArea{enabled:root.settings-ready;mouse-cursor:pointer;clicked=>{root.linked=!root.linked;root.save-settings();}}}
 Rectangle {width:26px;border-radius:6px;background:refresh.has-hover?#252832:transparent;
  Path{width:14px;height:14px;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:#b6bdcc;stroke-width:1.4px;commands:"M13.5 8 A5.5 5.5 0 1 1 11.6 3.9 M12 1 V4.5 H8.5";}
  refresh := TouchArea{mouse-cursor:pointer;clicked=>{root.refresh-display();}}}
 }
 if root.display-status!="": Hint{text:root.display-status;font-size:11px;}
 if root.displays.length==0: Hint{text:"Keine Monitore verfügbar";horizontal-alignment:center;}
 Rectangle {background:#13151a;border-radius:8px;
 VerticalLayout {padding-top:4px;padding-bottom:4px;spacing:0px;
 for row in root.displays: VerticalLayout {spacing:0px;
 if root.displays.length>1||!row.supported: Text{text:row.supported?row.name:row.name+" · "+row.status;color:#979eaf;font-size:11px;overflow:elide;height:16px;x:42px;}
 TipRow {height:36px;opacity:row.supported?1:0.45;text:row.name;inner-hover:dsl.hovered;inner-pressed:dsl.pressed;tip(t,x,y,h,s)=>{root.show-tip(t,x,y,h,s);}
 HorizontalLayout {padding-left:8px;padding-right:8px;spacing:10px;
 Rectangle{width:28px;MonitorIcon{width:24px;height:24px;}}
 dsl := ThinSlider{horizontal-stretch:1;value:row.value;enabled:row.supported;changed(value)=>{root.brightness(row.id,round(value));}}
 Text{width:36px;text:row.supported?row.value:"—";color:#e6e7ee;font-size:15px;horizontal-alignment:right;vertical-alignment:center;}
 }}
 }
 }
 }
 Hint{text:"Ohne DDC/CI oder interne Windows-Helligkeit bleibt ein Display sichtbar, aber nicht regelbar.";font-size:11px;}
 }
 if root.tab==3: VerticalLayout {spacing:8px;alignment:start;
 if root.expired: Rectangle {height:30px;background:#554125;border-radius:8px;Text{text:"✓  Dein Timer ist abgelaufen";color:#ffdb9a;horizontal-alignment:center;vertical-alignment:center;}}
 Card {VerticalLayout{padding:10px;spacing:6px;
 Hint{text:"COUNTDOWN";font-size:11px;}
 if root.countdown-active: Text{height:48px;text:root.countdown-text;color:root.expired?#ffcc88:root.accent;font-size:36px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
 if !root.countdown-active: Rectangle{height:48px;
 timefocus := FocusScope{
  init => {self.focus();}
  key-pressed(e) => {
   if e.text==Key.Return { root.countdown-action(0); return accept; }
   if e.text==Key.Backspace { root.time-backspace(false); return accept; }
   if e.text==Key.Delete { root.time-backspace(true); return accept; }
   if e.text==Key.UpArrow { root.time-step(root.time-seg,1); return accept; }
   if e.text==Key.DownArrow { root.time-step(root.time-seg,-1); return accept; }
   if e.text==Key.LeftArrow { root.time-seg=max(0,root.time-seg - 1); return accept; }
   if e.text==Key.RightArrow { root.time-seg=min(2,root.time-seg + 1); return accept; }
   if e.text.character-count==1 && e.text.is-float() && e.text!="." { root.time-digit(round(e.text.to-float())); return accept; }
   return reject;
  }
  HorizontalLayout{alignment:center;spacing:2px;
   TimeSeg{text:root.input-h;active:timefocus.has-focus&&root.time-seg==0;accent:root.accent;clicked=>{root.time-seg=0;timefocus.focus();}scrolled(d)=>{root.time-step(0,d);}}
   Text{text:":";color:#979eaf;font-size:36px;font-weight:600;vertical-alignment:center;}
   TimeSeg{text:root.input-m;active:timefocus.has-focus&&root.time-seg==1;accent:root.accent;clicked=>{root.time-seg=1;timefocus.focus();}scrolled(d)=>{root.time-step(1,d);}}
   Text{text:":";color:#979eaf;font-size:36px;font-weight:600;vertical-alignment:center;}
   TimeSeg{text:root.input-s;active:timefocus.has-focus&&root.time-seg==2;accent:root.accent;clicked=>{root.time-seg=2;timefocus.focus();}scrolled(d)=>{root.time-step(2,d);}}
  }
 }}
 HorizontalLayout {spacing:8px;ActionButton{text:root.expired?"Neu starten":root.countdown-running?"Pause":"Start / Weiter";primary:true;clicked=>{root.countdown-action(0);}} ActionButton{text:"Zurücksetzen";clicked=>{root.countdown-action(1);}}}
 }}
 Card{VerticalLayout{padding:10px;spacing:6px; Hint{text:"STOPPUHR";font-size:11px;}
 Text{height:48px;text:root.stopwatch-text;color:#f3f4f8;font-size:36px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
 HorizontalLayout{spacing:8px;ActionButton{text:root.stopwatch-running?"Pause":"Start / Weiter";primary:true;clicked=>{root.stopwatch-action(0);}}ActionButton{text:"Zurücksetzen";clicked=>{root.stopwatch-action(1);}}}
 }}
 Hint{text:"Läuft auch bei verborgenem Panel und im Standby weiter. Beim App-Neustart werden beide Uhren zurückgesetzt.";font-size:11px;}
 }
 if root.tab==2: VerticalLayout {spacing:6px;alignment:start;
 if root.system-status!="": Hint{text:root.system-status;font-size:11px;}
 StatRow{label:"CPU";text:root.cpu-text;pct:root.cpu-pct;level:root.cpu-level;accent:root.accent;}
 StatRow{label:"RAM";text:root.ram-text;pct:root.ram-pct;level:root.ram-level;accent:root.accent;}
 Rectangle{height:16px;Text{x:4px;width:parent.width - 8px;text:root.gpu-name;color:#979eaf;font-size:11px;overflow:elide;vertical-alignment:center;}}
 StatRow{label:"GPU";text:root.gpu-text;pct:root.gpu-pct;level:root.gpu-level;accent:root.accent;dimmed:!root.gpu-available;}
 StatRow{label:"VRAM";text:root.vram-text;pct:root.vram-pct;level:root.vram-level;accent:root.accent;dimmed:!root.gpu-available;}
 Hint{text:"Wird nur gemessen, solange dieser Tab offen ist.";font-size:11px;}
 }
 if root.tab==4: VerticalLayout {spacing:12px;alignment:start;
 Heading{text:"Einstellungen";}
 if root.settings-error!="": Hint{text:root.settings-error;color:#ffbc91;}
 Card{VerticalLayout{padding:14px;spacing:12px;
 Hint{text:"AKZENTFARBE";}
 Dropdown{model:root.accent-names;current-index:root.accent-index;open:root.dropdown-open&&root.dropdown-kind==0;enabled:root.settings-ready;toggled(x,y,w)=>{root.dd-x=x;root.dd-y=y;root.dd-w=w;root.dd-scroll0=root.scroll-y;root.dropdown-kind=0;root.dropdown-open=!root.dropdown-open;}}
 CheckBox{text:"Animationen";checked:root.animations;enabled:root.settings-ready;toggled=>{root.animations=self.checked;root.save-settings();}}
 CheckBox{text:"Bei Fokusverlust ausblenden";checked:root.focus-close;enabled:root.settings-ready;toggled=>{root.focus-close=self.checked;root.save-settings();}}
 CheckBox{text:"Displayhelligkeit koppeln";checked:root.linked;enabled:root.settings-ready;toggled=>{root.linked=self.checked;root.save-settings();}}
 CheckBox{text:"Mit Windows starten (im Tray)";checked:root.autostart;enabled:root.settings-ready;toggled=>{root.autostart=self.checked;root.save-settings();}}
 }}
 Card{VerticalLayout{padding:14px;spacing:12px;
 Hint{text:"NEXSEARCH-HOTKEY";}
 Dropdown{model:root.hotkey-names;current-index:root.hotkey-index;open:root.dropdown-open&&root.dropdown-kind==1;enabled:root.settings-ready;toggled(x,y,w)=>{root.dd-x=x;root.dd-y=y;root.dd-w=w;root.dd-scroll0=root.scroll-y;root.dropdown-kind=1;root.dropdown-open=!root.dropdown-open;}}
 if root.hotkey-status!="": Hint{text:root.hotkey-status;color:root.hotkey-warning?#ffbc91:#979eaf;}
 Hint{text:"SUCHFENSTER-POSITION";}
 Dropdown{model:root.position-names;current-index:root.position-index;open:root.dropdown-open&&root.dropdown-kind==2;enabled:root.settings-ready;toggled(x,y,w)=>{root.dd-x=x;root.dd-y=y;root.dd-w=w;root.dd-scroll0=root.scroll-y;root.dropdown-kind=2;root.dropdown-open=!root.dropdown-open;}}
 }}
 Card{VerticalLayout{padding:14px;spacing:10px;
 Hint{text:@tr("UPDATES");}
 Text{text:@tr("Installierte Version: {}", root.app-version);color:#f3f4f8;font-size:13px;wrap:word-wrap;height:self.preferred-height;}
 Text{text:root.update-status-text;color:root.update-state==8?#ffbc91:#b6bdcc;font-size:12px;wrap:word-wrap;height:self.preferred-height;}
 if root.update-state==3&&!root.update-managed: Hint{text:@tr("Diese Installation wurde nicht mit install.ps1 eingerichtet; bitte das Paket manuell installieren.");font-size:11px;}
 if root.update-state==8&&root.update-error-detail!="": Hint{text:root.update-error-detail;font-size:11px;}
 if root.update-state==4: Rectangle{height:6px;border-radius:3px;background:#343640;
  Rectangle{x:0px;width:root.update-progress<0?parent.width*0.15:parent.width*max(0,min(100,root.update-progress))/100;height:6px;border-radius:3px;background:root.accent;}}
 CheckBox{text:@tr("Automatisch prüfen (täglich)");checked:root.auto-update-check;enabled:root.settings-ready;toggled=>{root.auto-update-check=self.checked;root.save-settings();}}
 HorizontalLayout{spacing:8px;
  ActionButton{text:@tr("Jetzt prüfen");enabled:!root.update-busy;clicked=>{root.check-updates();}}
  if root.update-can-install: ActionButton{text:@tr("Jetzt aktualisieren");primary:true;enabled:!root.update-busy;clicked=>{root.install-update();}}
 }
 Hint{text:@tr("Versionen werden von GitHub geladen. Die Pakete sind nicht signiert; die SHA256-Prüfsumme stammt aus demselben Release und belegt nur einen vollständigen Download, nicht die Herkunft. Beim Aktualisieren startet NexPanel neu, laufende Timer werden zurückgesetzt.");font-size:11px;}
 }}
 Hint{text:root.settings-blocked?"Die vorhandene Datei bleibt unverändert. Zurücksetzen ersetzt sie durch Standardwerte.":"Lokal gespeichert · keine Konten · keine Telemetrie";}
 Button{text:"Einstellungen zurücksetzen";enabled:root.settings-ready;clicked=>{root.reset-settings();}}
 Hint{text:@tr("NexPanel {} · Windows 11", root.app-version)+"\nEsc und × blenden nur aus. Beenden über das Tray-Menü.";}
 }
 }
 }
 }
 if root.dropdown-open: DropdownList{model:root.dropdown-kind==1?root.hotkey-names:root.dropdown-kind==2?root.position-names:root.accent-names;current-index:root.dropdown-kind==1?root.hotkey-index:root.dropdown-kind==2?root.position-index:root.accent-index;list-x:root.dd-x;list-y:root.dd-live-y;list-width:root.dd-w;
  chosen(i)=>{
   if root.dropdown-kind==1 { root.hotkey-index=i; } else if root.dropdown-kind==2 { root.position-index=i; } else { root.accent-index=i; }
   root.dropdown-open=false;root.save-settings();}
  dismissed=>{root.dropdown-open=false;}}
 HoverTip{text:root.tip-text;anchor-x:root.tip-x;anchor-y:root.tip-y;anchor-h:root.tip-h;shown:root.tip-visible&&!root.dropdown-open;}
}
