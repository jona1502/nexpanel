---
const { title } = Astro.props;
const content = (await Astro.slots.render("default")).replaceAll('href="testing.md"', 'href="/testing"').replaceAll('href="setup.md"', 'href="/setup"');
---
<!doctype html>
<html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={`${title} für NexPanel 0.1 – lokale Windows-Anwendung.`}/><title>{title} – NexPanel</title></head><body><header><a href="/">← NexPanel</a><nav aria-label="Dokumentation"><a href="/setup">Setup</a><a href="/testing">Prüfstand</a></nav></header><main><Fragment set:html={content}/></main><footer><a href="https://github.com/jona1502/nexpanel">Quellcode auf GitHub ↗</a><span>Version 0.1 · lokal entwickelt</span></footer></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#111319;color:#eef0f8;font:16px/1.8 'Segoe UI',Arial,sans-serif}header,main,footer{width:min(860px,calc(100% - 40px));margin:auto}header,footer{display:flex;justify-content:space-between;gap:25px;padding:30px 0;border-bottom:1px solid #303542}header nav{display:flex;gap:22px}main{padding:35px 0 70px}h1{font-size:40px;line-height:1.2;letter-spacing:-1.3px}h2{margin-top:45px;font-size:26px;line-height:1.3}h3{font-size:21px}a{color:#9cb1ff;text-underline-offset:4px}a:focus-visible{outline:3px solid #809cff;outline-offset:5px}p,li{color:#b8bfce}pre{padding:22px;border:1px solid #303542;border-radius:8px;overflow:auto;font:13px/1.7 Consolas,monospace}code{font-family:Consolas,monospace;font-size:.88em;overflow-wrap:anywhere}p code,li code{color:#c4d1ff}footer{border-top:1px solid #303542;border-bottom:0;font-size:12px;color:#8d98ad;margin-bottom:20px}table{border-collapse:collapse;display:block;overflow:auto}td,th{padding:8px;border-bottom:1px solid #303542;text-align:left}@media(max-width:600px){h1{font-size:32px}pre{padding:15px}header,footer{flex-wrap:wrap}body{font-size:15px}}
</style>
