---
const repo = 'https://github.com/jona1502/nexpanel';
const features = [
  ['01', 'Tray-Popup am Icon.', 'Eigener Win32-Tray-Host: Das Panel öffnet direkt am Tray-Icon, das Icon kehrt nach einem Neustart des Explorers zurück. Esc oder Schließen blendet es aus.'],
  ['02', 'Kompakter Audio-Mixer.', 'Systemlautstärke und jede Anwendung mit eigenem Icon und Regler. Ein Klick auf das Icon schaltet die App stumm. Mehrere Sessions eines Prozesses werden zusammengefasst.'],
  ['03', 'Helligkeit pro Monitor.', 'Unterstützte externe Monitore per DDC/CI, interne Displays über verfügbare Windows-Schnittstellen. Einzeln regeln oder mit Kopplung gemeinsam.'],
  ['04', 'Countdown mit HH:MM:SS.', 'Zeit direkt als Stunden, Minuten und Sekunden eingeben. Der Countdown läuft im Hintergrund weiter, auch wenn das Panel geschlossen ist.'],
  ['05', 'Stoppuhr und Benachrichtigung.', 'Start, Pause und Reset. Läuft ein Countdown ab, meldet sich NexPanel mit einer Windows-Benachrichtigung (Balloon), ohne den Fokus zu stehlen. Standby-sicher.'],
  ['06', 'Einstellungen und Autostart.', 'Akzentfarbe, Animationen, gekoppelte Displays und optionaler Windows-Autostart. Autostart ist nie voreingestellt und nur hier zu aktivieren.'],
  ['07', 'Ruhig im Leerlauf.', 'Ereignisgesteuert statt Dauer-Polling: Audio über Systemereignisse, Displays über Hotplug-Ereignisse, der Update-Takt passt sich an. Geringer Leerlaufverbrauch ist ein Ziel, noch nicht gemessen.'],
  ['08', 'Protokoll und Über-Bereich.', 'Logdatei unter %LOCALAPPDATA%\\NexPanel\\logs für die Fehlersuche. Der Bereich Über NexPanel nennt die verwendeten Lizenzen, darunter Slint.'],
];
const next = ['Systemmonitor-Tab mit CPU, RAM und GPU', 'Profile und Automatisierungen', 'Frei platzierbare Widgets'];
const steps = [
  ['Tray-Icon anklicken', 'Das Panel öffnet direkt am Icon.'],
  ['Regeln', 'Lautstärke je App, Helligkeit je Monitor, Countdown oder Stoppuhr starten.'],
  ['Weiterarbeiten', 'Esc oder Schließen blendet das Panel aus. Timer laufen im Tray weiter und melden sich per Benachrichtigung.'],
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="NexPanel: Tray-Panel für Windows 11: Audio-Mixer pro App, Helligkeit pro Monitor, Countdown und Stoppuhr. Lokal, ohne Konto. Noch kein Download, selbst bauen." />
    <meta name="theme-color" content="#111319" />
    <title>NexPanel – Dein Windows. Ein Panel.</title>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="wrap"><a class="brand" href="#" aria-label="NexPanel Start"><span class="mark">N</span>NexPanel<span class="version">0.1</span></a><nav aria-label="Hauptnavigation"><a href="#funktionen">Funktionen</a><a href="#start">Selbst bauen <span aria-hidden="true">↗</span></a></nav></header>
    <main id="inhalt">
      <section class="hero wrap">
        <div class="intro"><p class="eyebrow"><span class="dot"></span> FÜR WINDOWS 11 · X64</p><h1>Dein Windows.<br/><em>Ein Panel.</em></h1><p class="lead">Monitor zu hell. Musik zu laut. Pause vergessen.<br class="desktop"/> Die kleinen Dinge verdienen einen kurzen Weg.</p><p class="hero-copy">Kompakter Audio-Mixer, Helligkeit pro Monitor, Countdown und Stoppuhr – direkt im System-Tray. Lokal auf deinem Rechner, ohne Konto und Cloud.</p><div class="actions"><a class="button" href="#start">Version 0.1 selbst bauen <span aria-hidden="true">↓</span></a><a class="text-link" href={repo}>Quellcode auf GitHub ↗</a></div><p class="fine">Lokaler Entwicklungsstand · Noch kein veröffentlichter Download</p></div>
        <div class="illustration"><div class="orbit-label">WENIGER SUCHEN. MEHR MACHEN.</div><div class="panel" role="img" aria-label="Illustration eines NexPanel-Panels mit Beispielwerten für Displays, Audio und Timer">
          <div class="panel-top"><span><b class="tiny-mark">N</b> NexPanel</span><span aria-hidden="true">×</span></div><div class="mock-tabs"><b>Übersicht</b><span>Displays</span><span>Audio</span><span>Zeit</span></div>
          <div class="mock-section"><span class="mock-label">DISPLAY</span><div class="mock-row"><span>Arbeitsmonitor</span><b>65<span>%</span></b></div><div class="track"><i style="width:65%"></i></div><p>Hardware-Helligkeit · DDC/CI</p></div>
          <div class="mock-section"><span class="mock-label">AUDIO</span><div class="mock-row"><span>Systemlautstärke</span><b>42<span>%</span></b></div><div class="track"><i style="width:42%"></i></div><div class="app-row"><span><span class="app-icon">♫</span> Musik</span><span>28 %</span></div></div>
          <div class="mock-timer"><div><span class="mock-label">COUNTDOWN</span><strong>24<span>:</span>59</strong></div><span class="pause" aria-hidden="true">Ⅱ</span></div><div class="panel-foot"><span class="dot"></span> Beispielwerte · Illustration</div>
        </div><div class="caption"><span>01 / DEIN KURZER WEG</span><span>Rust + Slint</span></div></div>
      </section>
      <div class="principles wrap"><span>Ein Klick im Tray.</span><span>Echte Hardwaresteuerung.</span><span>Deine Einstellungen bleiben lokal.</span></div>
      <section id="funktionen" class="features wrap section"><div class="section-heading"><p class="eyebrow">DAS WESENTLICHE, GRIFFBEREIT</p><h2>Acht Handgriffe.<br/>Ein ruhiger Arbeitsplatz.</h2></div><div class="feature-list">{features.map(([n,title,copy]) => <article><span class="number">{n}</span><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></section>
      <section id="so-funktionierts" class="how wrap section"><div><p class="eyebrow">SO FUNKTIONIERT'S</p><h2>Öffnen. Regeln.<br/>Weiterarbeiten.</h2></div><ol class="how-list">{steps.map(([t,c]) => <li><h3>{t}</h3><p>{c}</p></li>)}</ol></section>
      <section id="ansichten" class="shots wrap section" aria-labelledby="shots-h"><div><p class="eyebrow">ANSICHTEN</p><h2 id="shots-h">Das Panel im Überblick.</h2></div><div><p>Das Panel hat vier Bereiche: Übersicht, Displays, Audio und Zeit. Die Illustration oben zeigt nur Beispielwerte.</p>{/* TODO: echte Aufnahmen aus `--capture-preview <Verzeichnis>` hier als img mit alt-Text einbinden, sobald sie im Repo liegen. */}</div></section>
      <section class="detail wrap"><div><p class="eyebrow">DEIN PANEL, DEIN VERHALTEN</p><h2>Öffnen. Regeln.<br/>Weiterarbeiten.</h2><p>Ein Tray-Klick öffnet das Panel am Icon, Esc oder Schließen blendet es aus; Fokusverlust auf Wunsch ebenfalls. Alles läuft ohne Administratorrechte.</p><a class="text-link" href="/setup">Bedienung und Setup lesen ↗</a></div><aside><span class="eyebrow">GUT ZU WISSEN</span><h3>Hardware hat das letzte Wort.</h3><p>DDC/CI muss von Monitor, Anschluss und Treiber unterstützt werden (oft im Monitormenü aktivierbar). Interne Helligkeit benötigt einen passenden WMI-Anbieter. Unfähige oder mehrdeutige Geräte bleiben mit Erklärung sichtbar.</p><p>Kein dunkles Software-Overlay als Ersatz. Kein Versprechen, dass jeder Bildschirm regelbar ist.</p></aside></section>
      <section id="start" class="start section"><div class="wrap start-grid"><div><p class="eyebrow">VERSION 0.1 / LOKALER ENTWICKLUNGSSTAND</p><h2>Bereit für<br/><em>deinen Build.</em></h2><p>Windows 11 x64, Rust mit MSVC-Buildtools und PowerShell. Die Installation erfolgt benutzerlokal, ohne Administratorrechte, automatischen Start oder ungefragten Autostart.</p><a class="button" href={repo}>Repository öffnen ↗</a></div><div class="steps"><article><span>01</span><div><h3>Quellcode holen</h3><code>git clone https://github.com/jona1502/nexpanel.git<br/>cd nexpanel</code></div></article><article><span>02</span><div><h3>Release-Paket bauen</h3><code>./scripts/package.ps1</code><p>Erstellt das Windows-x64-ZIP inklusive Installation, Deinstallation und SHA256-Prüfsumme.</p></div></article><article><span>03</span><div><h3>Entpacken und installieren</h3><code>./install.ps1</code><p>Im entpackten Paket ausführen. Danach NexPanel über das Startmenü öffnen.</p></div></article><a class="text-link" href="/setup">Vollständige Voraussetzungen und Anleitung ↗</a></div></div></section>
      <section class="faq wrap section"><div><p class="eyebrow">KLARE ANTWORTEN</p><h2>Vor dem Start.</h2></div><div><details><summary>Welche Windows-Version?</summary><p>Nur Windows 11 (x64). Andere Systeme sind nicht vorgesehen.</p></details><details><summary>Warum lässt sich mein Monitor nicht regeln?</summary><p>DDC/CI muss von Monitor, Anschluss und Treiber unterstützt werden. Nicht unterstützte Geräte bleiben mit Erklärung sichtbar; NexPanel setzt kein Software-Overlay als Ersatz.</p></details><details><summary>Braucht NexPanel Administratorrechte?</summary><p>Nein. Installation und Betrieb laufen benutzerlokal. Autostart gibt es nur, wenn du ihn in den Einstellungen aktivierst.</p></details><details><summary>Ist alles lokal?</summary><p>Ja. Einstellungen liegen unter %LOCALAPPDATA%\NexPanel\settings.json, Logs unter %LOCALAPPDATA%\NexPanel\logs. Kein Konto, keine Cloud, keine Telemetrie. Eine Deinstallation erhält die Einstellungen.</p></details><details><summary>Läuft der Timer auch bei geschlossenem Panel?</summary><p>Ja, solange NexPanel im Tray läuft. Schlafzeit zählt mit. Beim Beenden oder Neustart der App werden die Zeitwerkzeuge zurückgesetzt.</p></details><details><summary>Welche Technik und Lizenz steckt dahinter?</summary><p>Rust und <a href="https://slint.dev">Slint</a> (Royalty-free-Lizenz, Hinweis im Bereich Über NexPanel). Details: <a href={repo + '/blob/main/docs/licensing.md'}>Lizenzen und Abhängigkeiten ↗</a>. Eine Projektlizenz für NexPanel selbst ist noch nicht gewählt.</p></details><details><summary>Was kommt als Nächstes?</summary><p>Noch nicht verfügbar und nicht Teil von Version 0.1:</p><ul>{next.map((n) => <li>{n}</li>)}</ul></details><details><summary>Wie weit ist die Version geprüft?</summary><p>Fachtests, lokale Builds und echte lesende Geräteabfragen liegen vor. Native Tray-Interaktion, reale Hardwareänderungen, Schlaf und Hotplug brauchen weitere praktische Prüfung. Performance ist noch nicht vermessen; Ressourcenziele sind Ziele, keine Zusagen.</p><a href="/testing">Nachweise und Grenzen ↗</a></details><details><summary>Gibt es schon einen fertigen Download?</summary><p>Noch nicht. Der aktuelle Weg ist der lokale Build aus dem Quellcode. Projektlizenz, Veröffentlichung und Codesignatur sind noch nicht festgelegt.</p></details></div></section>
    </main>
    <footer class="wrap"><a class="brand" href="#"><span class="mark">N</span>NexPanel</a><p>Ein kleines Panel für die täglichen Handgriffe.</p><a href={repo}>GitHub ↗</a><span>0.1 · lokal entwickelt</span></footer>
  </body>
</html>
<style is:global>
  :root{font-family:'Segoe UI',Arial,sans-serif;color:#eef0f8;background:#111319;font-synthesis:none;--muted:#a7adbd;--blue:#809cff;--line:#2d323e}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0}a{color:inherit;text-decoration:none}button,a,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:6px}a:hover{color:#b5c5ff}.wrap{width:min(1160px,calc(100% - 80px));margin:auto}header{height:110px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-weight:650;font-size:22px;letter-spacing:-.6px}.mark{display:grid;place-items:center;width:34px;height:34px;border:1px solid #586fae;border-radius:9px;color:var(--blue);font-size:23px}.version{font:11px Consolas,monospace;color:var(--muted);padding:4px 6px;border:1px solid var(--line);border-radius:4px;margin-left:3px}nav{display:flex;gap:34px;font-size:14px;color:#c1c7d6}.hero{display:grid;grid-template-columns:1.15fr 1fr;gap:70px;align-items:center;padding-top:58px;padding-bottom:85px}.eyebrow{font:11px Consolas,monospace;letter-spacing:1.8px;color:var(--blue);line-height:1.6}.dot{display:inline-block;width:6px;height:6px;background:var(--blue);border-radius:50%;margin-right:8px}h1{font-size:clamp(55px,5.8vw,78px);line-height:1.04;letter-spacing:-4px;margin:27px 0 29px;font-weight:620}em{font-style:normal;color:var(--blue)}.lead{font-size:21px;line-height:1.55;letter-spacing:-.3px;color:#d3d7e3}.hero-copy{max-width:440px;color:var(--muted);font-size:16px;line-height:1.8}.actions{display:flex;align-items:flex-start;flex-direction:column;gap:20px;margin-top:29px}.button{display:inline-flex;align-items:center;gap:22px;padding:16px 21px;background:var(--blue);color:#111828;border-radius:6px;font-weight:650;font-size:14px}.button:hover{background:#a2b5ff;color:#111828}.text-link{font-size:13px;color:#c7d2ff}.fine{font-size:11px;color:#858d9f;margin-top:23px}.illustration{position:relative;padding:35px 20px 0}.illustration:before{content:'';position:absolute;inset:50px -35px 25px;background:radial-gradient(ellipse,#3449873b,transparent 70%);z-index:-1}.orbit-label{font:9px Consolas,monospace;letter-spacing:2px;color:#6e778e;margin:0 0 21px 20px}.panel{max-width:365px;margin:auto;background:#191c24;border:1px solid #3a4051;border-radius:15px;box-shadow:0 30px 70px #0007;transform:rotate(-3deg);padding:20px}.panel-top{display:flex;justify-content:space-between;font-size:14px;color:#bbc1d0;margin-bottom:22px}.panel-top>span:first-child{display:flex;align-items:center;gap:9px;color:#f1f3fa}.tiny-mark{color:var(--blue);font-size:18px}.mock-tabs{display:flex;gap:16px;padding-bottom:14px;border-bottom:1px solid var(--line);font-size:10px;color:#969fb4}.mock-tabs b{color:var(--blue)}.mock-section{padding:21px 0 16px;border-bottom:1px solid var(--line)}.mock-label{font:9px Consolas,monospace;letter-spacing:1.5px;color:#8d97ae}.mock-row{display:flex;justify-content:space-between;align-items:center;margin:13px 0 17px;font-size:13px}.mock-row b{font-size:22px;font-weight:500}.mock-row b span{font-size:11px;color:#8994ac;margin-left:3px}.track{height:5px;background:#343b4d;border-radius:9px}.track i{display:block;height:100%;background:var(--blue);border-radius:9px;position:relative}.track i:after{content:'';position:absolute;right:0;top:-4px;width:12px;height:12px;background:#ced8ff;border-radius:50%}.mock-section p{font-size:9px;color:#7e899e;margin:12px 0 0}.app-row{display:flex;justify-content:space-between;font-size:11px;color:#a9b2c6;align-items:center;margin-top:21px}.app-icon{color:var(--blue);margin-right:7px}.mock-timer{display:flex;align-items:center;justify-content:space-between;margin:22px 0}.mock-timer strong{display:block;font:36px Consolas,monospace;letter-spacing:-2px;margin-top:7px}.mock-timer strong span{color:#6c7792}.pause{display:grid;place-items:center;width:37px;height:37px;background:#809cff24;color:var(--blue);border:1px solid #809cff55;border-radius:50%}.panel-foot{font-size:9px;color:#8995ac;border-top:1px solid var(--line);padding-top:15px}.panel-foot .dot{width:4px;height:4px}.caption{display:flex;justify-content:space-between;max-width:365px;margin:34px auto 0;font:9px Consolas,monospace;color:#69758e;letter-spacing:1px}.principles{display:flex;justify-content:space-between;border-block:1px solid var(--line);padding:25px 0;color:#a5afc3;font-size:12px}.principles span:before{content:'+';color:var(--blue);margin-right:15px}.section{padding-top:110px;padding-bottom:110px}h2{font-size:42px;line-height:1.16;letter-spacing:-1.8px;font-weight:550;margin:18px 0 27px}h3{font-weight:550;font-size:21px;letter-spacing:-.4px;margin:0 0 12px}p{line-height:1.75}.features{display:grid;grid-template-columns:1fr 1.2fr;gap:80px}.feature-list article{display:flex;gap:21px;padding:29px 0;border-bottom:1px solid var(--line)}.feature-list article:first-child{padding-top:0}.number{font:11px Consolas,monospace;color:#68748f;padding-top:5px}.feature-list p{color:var(--muted);font-size:14px;margin:0;max-width:400px}.arrow{color:var(--blue);margin-left:auto}.detail{display:grid;grid-template-columns:1fr 1fr;gap:110px;padding-bottom:110px}.detail>div>p:not(.eyebrow),.start-grid>div>p:not(.eyebrow){color:var(--muted);font-size:15px;max-width:440px}.detail aside{border:1px solid var(--line);border-left:2px solid var(--blue);padding:32px;background:#181b23;align-self:center}.detail aside h3{margin-top:16px}.detail aside p{color:var(--muted);font-size:14px;margin-bottom:0}.start{background:#191d29;border-block:1px solid #303849}.start-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:100px}.start h2{font-size:53px}.start .button{margin-top:18px}.steps article{display:flex;gap:23px;padding:24px 0;border-bottom:1px solid #343c50}.steps article:first-child{padding-top:0}.steps article>span{font:12px Consolas,monospace;color:var(--blue);padding-top:4px}.steps h3{font-size:17px}code{font:12px/1.8 Consolas,monospace;color:#c6d2ff;overflow-wrap:anywhere}.steps p{font-size:13px;color:var(--muted);margin-bottom:0}.steps>.text-link{display:block;margin-top:23px}.faq{display:grid;grid-template-columns:1fr 1.2fr;gap:80px}.faq details{border-bottom:1px solid var(--line);padding:21px 0}.faq details:first-child{padding-top:0}summary{cursor:pointer;font-size:16px;line-height:1.6;padding-right:18px}.faq details p{color:var(--muted);font-size:14px}.faq details a{font-size:13px;color:var(--blue)}footer{display:flex;align-items:center;gap:32px;border-top:1px solid var(--line);padding:32px 0 45px}footer p{font-size:12px;color:#7e899e;margin-right:auto}footer>a:not(.brand),footer>span{font-size:11px;color:#8b95a9}.skip{position:absolute;top:-100px;left:20px;z-index:5;background:var(--blue);color:#111;padding:10px}.skip:focus{top:10px}@media(max-width:900px){.wrap{width:calc(100% - 48px)}.hero{gap:20px}h1{font-size:58px;letter-spacing:-3px}.lead{font-size:18px}.illustration{padding-inline:0}.features,.faq{gap:40px}.detail,.start-grid{gap:50px}.principles{gap:15px}.principles span{max-width:190px}footer{flex-wrap:wrap}footer p{width:60%}}@media(max-width:650px){.wrap{width:calc(100% - 40px)}header{height:85px}nav{gap:18px;font-size:12px}.brand{font-size:19px}.version{display:none}.hero{grid-template-columns:1fr;padding-top:35px;padding-bottom:55px;gap:25px}h1{font-size:64px}.lead{font-size:19px}.illustration{max-width:390px;width:100%;margin:0 auto;padding:25px 10px 0}.orbit-label{font-size:8px}.panel{transform:rotate(-2deg)}.principles{display:grid;grid-template-columns:1fr;gap:16px;padding-block:23px}.principles span{max-width:none}.section{padding-block:65px}.features,.detail,.start-grid,.faq{grid-template-columns:1fr;gap:33px}.detail{padding-bottom:65px}h2{font-size:36px}.start h2{font-size:45px}.feature-list article{gap:15px}.detail aside{padding:25px}.faq details:first-child{padding-top:10px}footer{gap:20px;padding-bottom:30px}footer p{width:100%;order:4;margin:0}.desktop{display:none}}.how{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;padding-top:0}.how-list{margin:0;padding:0;list-style:none;counter-reset:s}.how-list li{counter-increment:s;padding:0 0 26px 52px;position:relative;border-bottom:1px solid var(--line);margin-bottom:26px}.how-list li:before{content:"0" counter(s);position:absolute;left:0;top:4px;font:11px Consolas,monospace;color:var(--blue)}.how-list p,.shots p{color:var(--muted);font-size:14px;margin:0}.shots{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;padding-top:0}.faq ul{color:var(--muted);font-size:14px;line-height:1.75}.faq details p a{color:var(--blue)}@media(max-width:650px){.how,.shots{grid-template-columns:1fr;gap:33px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
